# Copy this file to .env.local and fill in your values.

# API key for your AI provider (Google AI Studio, OpenAI, OpenRouter, etc.)
OPENAI_API_KEY=your-api-key-here

# Base URL for the OpenAI-compatible endpoint of your chosen provider
OPENAI_BASE_URL=your-base-url-here

# Model name to use (e.g. gemini-3.6-flash, gpt-4o-mini)
OPENAI_MODEL=your-model-here
